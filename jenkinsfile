pipeline {
    agent any

    environment {
        // 호스트의 테라폼 경로를 보장하기 위해 PATH 설정 (필요시)
        TF_PATH = '/usr/local/bin'
        PATH = "${TF_PATH}:${env.PATH}"
    }

    stages {
        stage('Checkout') {
            steps {
                // Multibranch Pipeline은 자동으로 현재 브랜치 코드를 Checkout 합니다.
                checkout scm
            }
        }

        stage('Terraform Init') {
            steps {
                sh 'chmod -R +w .terraform || true'
                sh 'rm -rf .terraform .terraform.lock.hcl'
                sh 'terraform init -upgrade'
            }
        }

        stage('Terraform Plan') {
            steps {
                // 변경 사항 미리보기
                sh 'terraform plan -out=tfplan'
            }
        }

        stage('Terraform Apply') {
          when {
                // 'main' 브랜치뿐만 아니라 'feature/'로 시작하는 모든 브랜치 허용
                anyOf {
                    branch 'main'
                    branch 'feature/*'  // Ant-style wildcard 사용
                }
            }
            steps {
                // 사용자의 최종 승인을 기다리는 단계 (실무 필수!)
                input message: "실제 인프라에 반영하시겠습니까?", ok: "승인"
                sh 'terraform apply -auto-approve tfplan'
            }
        }
    }
}
